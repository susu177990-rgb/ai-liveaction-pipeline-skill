{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Liveaction Asset Entry",
  "type": "object",
  "required": [
    "asset_id",
    "asset_type",
    "display_name"
  ],
  "properties": {
    "asset_id": { "type": "string" },
    "asset_type": {
      "type": "string",
      "enum": ["subject", "scene", "prop", "style"]
    },
    "display_name": { "type": "string" },
    "reference_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "lock_rules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "allowed_changes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "forbidden_changes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" }
  }
}
